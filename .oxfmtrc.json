{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": ["**/out/**", "**/dist/**", "**/pnpm-lock.yaml", "**/routeTree.gen.ts"],
  "sortImports": {
    "newlinesBetween": true,
    "groups": [
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index", "style", "side_effect_style"],
      "unknown"
    ]
  }
}
